# Copy to .env (git-ignored) and fill in. chmod 600 .env
# Paper account ID ("DU" + digits). Blank = the only account the Gateway manages.
IB_ACCOUNT=

# Email alerts (e.g. Gmail: smtp.gmail.com, 587, an app password - not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=

# Event-driven stack (eventbot/). Paper ports only: 4002 (Gateway) or 7497 (TWS).
IB_HOST=127.0.0.1
IB_PORT=4002
# Must differ from the IDs used by the daily bot's tools and the sibling repos.
IB_CLIENT_ID=71
KAFKA_BOOTSTRAP=localhost:9092
REDIS_URL=redis://localhost:6379/0
